# Go reads process environment; it does not automatically load this file.
APP_ENV=development
HOST=127.0.0.1
PORT=8080
# Optional in development: empty => /ready responds 503.
# Use a restricted runtime PostgreSQL role, not migration/admin credentials.
DATABASE_URL=
# Supabase Auth verifies cashier Bearer tokens, never service_role here
SUPABASE_URL=https://aiptdjypuccoakyfvdyl.supabase.co
SUPABASE_ANON_KEY=
# Exact comma-separated browser origins; empty disables WebSocket + dispatcher.
# Local Caddy example: http://127.0.0.1:5594
REALTIME_ORIGINS=
