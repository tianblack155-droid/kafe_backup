[Unit]
Description=TerasKayuManis Nuxt Web (preview)
After=network-online.target tkm-api.service
Wants=network-online.target tkm-api.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=tkm-web
Group=tkm-web
WorkingDirectory=/opt/teraskayumanis/current
EnvironmentFile=/etc/teraskayumanis/frontend.env
ExecStart=/opt/teraskayumanis/current/node /opt/teraskayumanis/current/web/server/index.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=768M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
